import flask
import pymongo

# Função para conectar ao MongoDB
def get_client():
    # Adicione a URL de conexão padrão
    return pymongo.MongoClient("mongodb://localhost:27017/")

def get_collection(col_name):
    client = get_client()
    # Aqui definimos o nome do banco (ex: 'meu_banco') e a coleção
    db = client['test'] 
    return db[col_name]

def list_users(col):
    return col.find()

app = flask.Flask(__name__)

@app.route('/users', methods=['GET'])
def get_users():
    # Buscamos a coleção 'users'
    user_col = get_collection('users')

    # Geramos a lista a partir do que vem do banco
    users_list = [
        {
            'id': str(u.get('_id')), # Convertemos o ID para string para evitar erro no JSON
            'username': u.get('username')
        } for u in list_users(user_col)
    ]
    return flask.jsonify(users_list)

if __name__ == '__main__':
    # ESTA LINHA PRECISA DE 4 ESPAÇOS DE RECUO (IDENTAÇÃO)
    app.run(host='0.0.0.0', debug=True)

def add_user(collection, user):
    collection.insert_one(user)
    return collection.find(user)

